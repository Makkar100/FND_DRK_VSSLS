# Copy to /etc/ais/ais.env (owner root:ais, chmod 640) and fill in the key.
AISSTREAM_API_KEY=replace-me

# Phase 1 AOI: Eastern OPL. JSON list of [[lat_min, lon_min], [lat_max, lon_max]].
AIS_BBOXES=[[[1.2,104.0],[2.6,105.5]]]
AIS_MESSAGE_TYPES=PositionReport,ShipStaticData

# rclone remote for Google Drive (configure with `rclone config` as the ais user).
RCLONE_REMOTE=gdrive:drk-vssl/ais
PRUNE_MIN_AGE_DAYS=7
UNSYNCED_ALERT_HOURS=48
